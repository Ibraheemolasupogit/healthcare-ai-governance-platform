# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Test / coverage / lint
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environment / secrets — never commit real values
.env
.env.*
!.env.example
*.pem
*.key

# Terraform
infrastructure/terraform/**/.terraform/
infrastructure/terraform/**/.terraform.lock.hcl
infrastructure/terraform/**/*.tfstate
infrastructure/terraform/**/*.tfstate.*
infrastructure/terraform/**/crash.log
infrastructure/terraform/**/*.tfvars
!infrastructure/terraform/**/*.tfvars.example

# Generated / local-only outputs
outputs/*
!outputs/.gitkeep
!outputs/README.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
